<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= article.title || article.draftTitle %> - The Daily Web</title>
    <!-- Plain-text summary of the article body (HTML stripped in articleController) -->
    <meta name="description" content="<%= metaDescription || 'News article from The Daily Web' %>">
    
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <!-- Shared Header -->
    <header class="site-header">
        <nav class="site-nav">
            <a href="/" class="site-logo">The Daily Web</a>
            <div class="nav-links">
                <a href="/">Home</a>
                <% if (user) { %>
                    <% if (user.role === 'editor') { %>
                        <a href="/editor-dashboard">Editor Dashboard</a>
                    <% } %>
                    <span class="nav-user-info"><%= user.username %> (<%= user.role %>)</span>
                    <a href="/auth/logout">Logout</a>
                <% } else { %>
                    <a href="/auth/login">Staff Login</a>
                <% } %>
            </div>
        </nav>
    </header>

    <%
        // Staff viewing logic (showDraft is decided in articleController:
        // the working version of an unpublished article or of an update in progress)
        const isStaff = user && user.role !== 'guest';
        const displayTitle   = showDraft ? article.draftTitle   : article.title;
        const displayContent = showDraft ? article.draftContent : article.content;
        const displayDate    = article.publishedAt || article.createdAt;
    %>

    <main class="article-page">

        <!-- Staff Notices -->
        <% if (isStaff && article.status !== 'published') { %>
            <div class="staff-notice notice-draft">
                <strong>Status: <%= article.status.toUpperCase() %></strong>
                <% if (showDraft) { %>&mdash; You are currently viewing the unpublished draft version.<% } %>
            </div>
        <% } else if (isStaff && article.revisionStatus) { %>
            <div class="staff-notice notice-draft">
                <strong>Published &middot; update <%= article.revisionStatus.toUpperCase() %></strong>
                <% if (showDraft) { %>&mdash; You are viewing the unpublished update. Readers still see the last approved version.<% } %>
            </div>
        <% } %>

        <% if (isStaff && article.editorNote) { %>
            <div class="staff-notice notice-editor">
                <strong>Editor's Note:</strong> <%= article.editorNote %>
            </div>
        <% } %>

        <!-- Article Content -->
        <article>
            <header class="article-header">
                <span class="article-category"><%= article.category %></span>
                <h1 class="article-title"><%= displayTitle %></h1>
                
                <div class="article-meta">
                    <div class="meta-author">
                        By <strong><%= article.author.username %></strong>
                    </div>
                    <div class="meta-details">
                        <time datetime="<%= displayDate.toISOString() %>">
                            <%= displayDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                        </time>
                        &bull; <%= article.viewsCount %> Views
                    </div>
                </div>
            </header>

            <% if (article.imageUrl) { %>
                <div class="article-image-container">
                    <img src="<%= article.imageUrl %>" alt="<%= displayTitle %>">
                </div>
            <% } %>

            <div class="article-body">
                <%- displayContent %>
            </div>
        </article>

        <!-- Comments Section (To be implemented by Student 3) -->
        <section class="comments-section">
            <h3>Comments</h3>
            
            <form id="add-comment-form" class="comment-form">
                <textarea name="content" placeholder="Share your thoughts on this article..." required></textarea>
                <button type="submit" class="btn-comment">Post Comment</button>
            </form>

            <div id="comments-container" style="margin-top: 30px;">
                <p style="color: var(--light-text); font-style: italic;">Comments are currently loading...</p>
                <!-- AJAX injected comments will appear here -->
            </div>
        </section>

    </main>

</body>
</html>
