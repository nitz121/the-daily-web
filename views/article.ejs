<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= article.title || article.draftTitle %> - The Daily Web</title>
    <!-- Plain-text summary of the article body (HTML stripped in articleController) -->
    <meta name="description" content="<%= metaDescription || 'News article from The Daily Web' %>">
    
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/comments.css">
</head>
<body>

    <!-- Shared Header -->
    <header class="site-header">
        <nav class="site-nav">
            <a href="/" class="site-logo">The Daily Web</a>
            <div class="nav-links">
                <a href="/">Home</a>
                <% if (user) { %>
                    <% if (user.role === 'reporter') { %>
                        <a href="/reporter-dashboard">My Articles</a>
                    <% } else if (user.role === 'editor') { %>
                        <a href="/editor-dashboard">Editor Dashboard</a>
                    <% } %>
                    <span class="nav-user-info"><%= user.username %> (<%= user.role %>)</span>
                    <a href="/auth/logout">Logout</a>
                <% } else { %>
                    <a href="/auth/login">Staff Login</a>
                <% } %>
            </div>
        </nav>
    </header>

    <%
        // Staff viewing logic (showDraft is decided in articleController:
        // the working version of an unpublished article or of an update in progress)
        const isStaff = user && user.role !== 'guest';
        const displayTitle   = showDraft ? article.draftTitle   : article.title;
        const displayContent = showDraft ? article.draftContent : article.content;
        const displayDate    = article.publishedAt || article.createdAt;
    %>

    <main class="article-page">

        <!-- Staff Notices -->
        <% if (isStaff && article.status !== 'published') { %>
            <div class="staff-notice notice-draft">
                <strong>Status: <%= article.status.toUpperCase() %></strong>
                <% if (showDraft) { %>&mdash; You are currently viewing the unpublished draft version.<% } %>
            </div>
        <% } else if (isStaff && article.revisionStatus) { %>
            <div class="staff-notice notice-draft">
                <strong>Published &middot; update <%= article.revisionStatus.toUpperCase() %></strong>
                <% if (showDraft) { %>&mdash; You are viewing the unpublished update. Readers still see the last approved version.<% } %>
            </div>
        <% } %>

        <% if (isStaff && article.editorNote) { %>
            <div class="staff-notice notice-editor">
                <strong>Editor's Note:</strong> <%= article.editorNote %>
            </div>
        <% } %>

        <!-- Article Content -->
        <article>
            <header class="article-header">
                <span class="article-category"><%= article.category %></span>
                <h1 class="article-title"><%= displayTitle %></h1>
                
                <div class="article-meta">
                    <div class="meta-author">
                        By <strong><%= article.author.username %></strong>
                    </div>
                    <div class="meta-details">
                        <time datetime="<%= displayDate.toISOString() %>">
                            <%= displayDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                        </time>
                        &bull; <%= article.viewsCount %> Views
                    </div>
                </div>
            </header>

            <% if (article.imageUrl) { %>
                <div class="article-image-container">
                    <img src="<%= article.imageUrl %>" alt="<%= displayTitle %>">
                </div>
            <% } %>

            <div class="article-body">
                <%- displayContent %>
            </div>
        </article>

        <!-- Comments Section (Student 3): loaded and posted via AJAX - public/js/comments.js -->
        <section class="comments-section" id="comments"
                 data-article-id="<%= article._id %>"
                 data-can-moderate="<%= user && user.role === 'editor' ? 'true' : 'false' %>">
            <h3>Comments <span id="comments-count" class="comments-count"></span></h3>

            <% if (article.status === 'published') { %>
                <form id="add-comment-form" class="comment-form" novalidate>
                    <label for="comment-author" class="visually-hidden">Your name</label>
                    <input type="text" id="comment-author" name="authorName" class="comment-name-input"
                           maxlength="50" placeholder="Your name (optional)" autocomplete="name">

                    <label for="comment-content" class="visually-hidden">Your comment</label>
                    <textarea id="comment-content" name="content" maxlength="1000"
                              placeholder="Share your thoughts on this article..." required></textarea>

                    <div class="comment-form-footer">
                        <span id="comment-char-count" class="comment-char-count">0/1000</span>
                        <button type="submit" class="btn-comment">Post Comment</button>
                    </div>
                    <p id="comment-form-message" class="comment-form-message" role="alert" hidden></p>
                </form>
            <% } else { %>
                <p class="comments-closed">Comments will open once this article is published.</p>
            <% } %>

            <p id="comments-status" class="comments-status">Loading comments...</p>
            <ol id="comments-list" class="comments-list"></ol>
            <button type="button" id="load-more-comments" class="btn-load-more" hidden>Load more comments</button>
        </section>

    </main>

    <script src="/js/comments.js"></script>

</body>
</html>
